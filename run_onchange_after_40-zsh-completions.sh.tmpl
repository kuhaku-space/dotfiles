#!/usr/bin/env bash
# refresh-zsh-completions hash: {{ include "dot_local/bin/executable_refresh-zsh-completions" | sha256sum }}
set -eu

REFRESH="$HOME/.local/bin/refresh-zsh-completions"
if [ ! -x "$REFRESH" ]; then
  printf "%s is not present yet. Skipping...\n" "$REFRESH"
  exit 0
fi

"$REFRESH" --force
