#!/usr/bin/env bash
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise.lock hash: {{ include "dot_config/mise/private_mise.lock" | sha256sum }}
set -eu

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
if [ ! -x "$MISE" ]; then
  printf "mise is not installed. Skipping...\n"
  exit 0
fi

if [ -n "${CI:-}" ]; then
  printf "\e[1;36mInstall tools via mise (CI: shell-startup subset only)\e[m\n"
  "$MISE" install atuin sheldon starship zoxide fzf deno bat eza usage
  exit 0
fi

printf "\e[1;36mInstall tools via mise\e[m\n"
"$MISE" install
"$MISE" prune
