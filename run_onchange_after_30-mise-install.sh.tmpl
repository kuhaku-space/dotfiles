#!/usr/bin/env bash
# mise の設定が変わると再実行される。
# 下記ハッシュは config.toml と mise.lock の内容に連動し、変更を検知するためのもの。
# lock 側も見るのは、他のマシンで `mise upgrade` した結果を pull しただけで
# インストールが走るようにするため。
# config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise.lock hash: {{ include "dot_config/mise/private_mise.lock" | sha256sum }}
set -eu

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
if [ ! -x "$MISE" ]; then
  printf "mise is not installed. Skipping...\n"
  exit 0
fi

# CI（bootstrap smoke test）で検証したいのは bootstrap の経路が通ること。
# rust / node / neovim まで入れると 30分近くかかるので、シェル起動と補完生成に
# 必要な分だけに絞る。**CI では以下のツール以外はインストールされない**。
if [ -n "${CI:-}" ]; then
  printf "\e[1;36mInstall tools via mise (CI: shell-startup subset only)\e[m\n"
  "$MISE" install sheldon starship zoxide fzf deno bat eza usage
  exit 0
fi

printf "\e[1;36mInstall tools via mise\e[m\n"
"$MISE" install
"$MISE" prune
