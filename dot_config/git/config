[user]
	name = kuhaku-space
	email = 67200331+kuhaku-space@users.noreply.github.com
	signingKey = ~/.ssh/id_ed25519.pub
[core]
	quotepath = false
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgsign = true
[merge]
	ff = false
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoUpdate = true
[fetch]
	prune = true
	pruneTags = true
[pull]
	ff = only
[push]
	default = current
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = zebra
[branch]
	sort = -committerdate
[column]
	ui = auto
[init]
	defaultBranch = main
[alias]
	delete-merged-branch = "!f() { git checkout \"${1:-main}\" && git pull && git branch --merged | grep -vE \"^\\*|^\\s*(develop|main|master)$\" | xargs -r git branch -d; }; f"
	delete-gone-branch = "!f() { git checkout \"${1:-main}\" && git pull && git fetch --prune && git branch -vv | grep \"\\[[^]]*: gone\\]\" | grep -vE \"^\\*|^\\s*(develop|main|master)$\" | awk \"{print \\$1}\" | xargs -r git branch -D; }; f"
[ghq]
	vcs = gh
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
[include]
	path = config.local
