export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

if [ -z "${LANG:-}" ]; then
  export LANG="C.UTF-8"
fi

export HISTFILE="$XDG_STATE_HOME/zsh/history"
export HISTSIZE=10000
export SAVEHIST=10000

export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"

export ZENO_HOME="$XDG_CONFIG_HOME/zeno"
export ZENO_ENABLE_SOCK=1
export ZENO_GIT_CAT="bat --color=always"
export ZENO_GIT_TREE="eza --tree"

export FZF_DEFAULT_OPTS="--reverse"

# Register every completer provided by Carapace; native fallbacks are kept only
# for commands Carapace does not support.
unset CARAPACE_EXCLUDES

for _openssl_libdir in "/usr/lib/${CPUTYPE:-$(uname -m)}-linux-gnu" /usr/lib64 /usr/lib; do
  if [ -e "$_openssl_libdir/libssl.so" ] && [ -e /usr/include/openssl/ssl.h ]; then
    export OPENSSL_LIB_DIR="$_openssl_libdir"
    export OPENSSL_INCLUDE_DIR="/usr/include"
    break
  fi
done
unset _openssl_libdir

export NODE_REPL_HISTORY="$XDG_DATA_HOME/node_repl_history"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"

export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"

skip_global_compinit=1

if [ -n "$ZSH_VERSION" ]; then
  typeset -U path
  # WSL appends Windows directories (/mnt/c/...); every lookup through them
  # crosses 9P, and mise rescans PATH on activate and on every prompt.
  path=(${path:#/mnt/[a-z]/*})
  # mise rebuilds PATH from this when inherited from an activated parent.
  if [[ -n ${__MISE_ORIG_PATH-} ]]; then
    export __MISE_ORIG_PATH=${(j.:.)${${(s.:.)__MISE_ORIG_PATH}:#/mnt/[a-z]/*}}
  fi
  path+=("$XDG_DATA_HOME/mise/shims" "$HOME/.local/bin" "$CARGO_HOME/bin")
  typeset -U fpath
  fpath=("$XDG_DATA_HOME/zsh/completions" $fpath)
else
  export PATH="$PATH:$XDG_DATA_HOME/mise/shims:$HOME/.local/bin:$CARGO_HOME/bin"
fi

if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
else
  export EDITOR="vi"
fi
if command -v code >/dev/null 2>&1; then
  export VISUAL="code --wait"
else
  export VISUAL="$EDITOR"
fi
