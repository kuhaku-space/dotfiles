# dotfiles の同期状態をまとめて見る。
#
# 以前はこれをシェル起動ごとに走らせて「未コミット」を警告していたが、やめた。
# 見ていたのはソースの作業ツリーだけで、$HOME 側の実ファイルを直接編集して
# re-add を忘れるズレも、未 push も検知できていなかった。しかも chezmoi の
# autoCommit / autoPush が commit と push を自動でやるので、警告すべき対象が
# ほとんど残っていない。消せない警告を全シェルで鳴らすより、必要なときに呼ぶ方がよい。
#
# re-add 忘れは apply で即座に消えるわけではない。chezmoi が最後に書いた後に
# ターゲットが変わっていれば apply は diff/overwrite/skip を聞いてくる。ただし
# 聞かれるのは apply の途中なので事前には見えず、chezmoi が一度も書いていない
# ファイル（新規マシンに既存ファイルがある等）は聞かれずに上書きされる。
# だからズレは apply を打つ前にこの関数で見る。
function dotfiles-status() {
  command -v chezmoi >/dev/null 2>&1 || {
    echo "chezmoi not found" >&2
    return 1
  }

  # zsh では $status が $? の別名（読み取り専用）なので、変数名に使わない。
  local src drift
  src="$(chezmoi source-path)" || return 1

  echo -e "\e[1;36m[dotfiles] $src\e[m"
  # 未コミットの変更と ahead/behind（未 push もここに出る）
  git -C "$src" status --short --branch

  # $HOME とソースの差分（re-add 忘れ / apply 忘れ）
  drift="$(chezmoi status)"
  if [ -n "$drift" ]; then
    echo -e '\e[1;33m[dotfiles] $HOME とソースの差分 (M: 内容が違う / A: 未展開 / D: 削除予定)\e[m'
    echo "$drift"
  fi
}

# dotfiles / apt / mise / sheldon をまとめて更新する
function update() {
  # dotfiles を最初に更新する。順番には意味がある。この後の mise ブロックは
  # mise.lock を re-add し、autoCommit がソースにローカルコミットを作る。先に
  # pull していないと、そのコミットが chezmoi update の `git pull --rebase` で
  # 他マシンの lock 更新の上に replay され、同じ version / checksum 行を両方が
  # 書き換えているのでコンフリクトする。pull が失敗した時点で apply は走らないため、
  # $HOME には何も反映されないままソースが rebase 途中で残る。先に pull しておけば
  # re-add のコミットは fast-forward で push でき、rebase する対象が残らない。
  if command -v chezmoi >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] dotfiles (chezmoi)\e[m"
    chezmoi update
  fi

  if command -v apt >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] apt\e[m"
    sudo apt update -qq &&
      sudo apt upgrade -qq -y &&
      sudo apt autoremove -qq -y &&
      sudo apt autoclean -qq -y &&
      sudo apt clean -qq -y
  fi

  if command -v mise >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] mise\e[m"
    mise self-update -y && mise upgrade && mise prune

    # mise.lock は $HOME 側で書き換わる生成物なので、更新後にソースへ取り込む。
    # 取り込まないと次の `chezmoi apply` が古い lock で上書きしてしまう。
    # （chezmoi の autoCommit / autoPush が commit と push まで行う）
    local mise_lock="${XDG_CONFIG_HOME:-$HOME/.config}/mise/mise.lock"
    if [ -f "$mise_lock" ] && command -v chezmoi >/dev/null 2>&1; then
      chezmoi re-add "$mise_lock"
    fi
  fi

  # sheldon のプラグインは plugins.lock に固定されるので、明示的に更新しないと
  # 一度 lock された版のまま古くなり続ける。
  if command -v sheldon >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] sheldon\e[m"
    sheldon lock --update
  fi

  # ツールが入れ替わると、そこから生成したキャッシュ（starship の init 出力・
  # 補完ダンプ）が古くなる。捨てておけば次のシェル起動で作り直される。
  echo -e "\e[1;36m[update] drop generated zsh caches\e[m"
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship-init.zsh" \
    "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-"*
}

eval "$(mise activate zsh)"
eval "$(sheldon source)"

# 以下 zsh-defer するものは「最初のプロンプト表示に間に合わなくてよい」もの。
# zsh-defer は登録順に実行するので、sheldon が登録した compinit / zeno /
# zsh-autosuggestions の読み込みは、ここで登録する処理より先に完了する。

# ssh-agent の起動はプロンプト表示に不要。
zsh-defer -c "ssh-add -l 2>/dev/null | grep -q 'SHA256' || eval \$(keychain --eval --nogui --quiet --agents ssh ~/.ssh/id_ed25519)"

setopt auto_cd
setopt hist_ignore_all_dups
setopt hist_ignore_space   # 先頭にスペースを付けたコマンドは履歴に残さない
setopt hist_reduce_blanks  # 余分な空白を詰めて履歴に入れる
setopt extended_history    # 実行時刻と所要時間も記録する
setopt inc_append_history  # シェル終了時ではなく実行ごとに履歴を書き出す
setopt nonomatch

# widget を提供するプラグイン（zsh-autosuggestions / zeno）は defer で読まれるので、
# bindkey も同じく defer する。即時に張ると、プラグインが読まれるまでの短い間だけ
# `No such widget` になり、そのキー入力（特にスペース）が捨てられる。
zsh-defer -c "bindkey '^ ' autosuggest-accept"
zsh-defer -c "bindkey ' ' zeno-auto-snippet; bindkey '^]' zeno-ghq-cd; bindkey '^r' zeno-history-selection; bindkey '^x' zeno-insert-snippet"
