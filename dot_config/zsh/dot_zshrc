function dotfiles-status() {
  command -v chezmoi >/dev/null 2>&1 || {
    echo "chezmoi not found" >&2
    return 1
  }

  local src drift
  src="$(chezmoi source-path)" || return 1

  echo -e "\e[1;36m[dotfiles] $src\e[m"
  git -C "$src" status --short --branch

  drift="$(chezmoi status)"
  if [ -n "$drift" ]; then
    echo -e '\e[1;33m[dotfiles] $HOME とソースの差分 (M: 内容が違う / A: 未展開 / D: 削除予定)\e[m'
    echo "$drift"
  fi
}

function update() {
  if command -v chezmoi >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] dotfiles (chezmoi)\e[m"
    chezmoi update
  fi

  if command -v apt >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] apt\e[m"
    sudo apt update -qq &&
      sudo apt upgrade -qq -y &&
      sudo apt autoremove -qq -y &&
      sudo apt autoclean -qq -y &&
      sudo apt clean -qq -y
  fi

  if command -v mise >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] mise\e[m"
    mise self-update -y && mise upgrade -C "$HOME" && mise prune

    local mise_lock="${XDG_CONFIG_HOME:-$HOME/.config}/mise/mise.lock"
    if [ -f "$mise_lock" ] && command -v chezmoi >/dev/null 2>&1; then
      chezmoi re-add "$mise_lock"
    fi
  fi

  if command -v sheldon >/dev/null 2>&1; then
    echo -e "\e[1;36m[update] sheldon\e[m"
    sheldon lock --update
  fi

  echo -e "\e[1;36m[update] drop generated zsh caches\e[m"
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship-init.zsh"
}

function clip() {
  if [[ -n "$WAYLAND_DISPLAY" ]] && (( $+commands[wl-copy] )); then
    wl-copy
  elif [[ -n "$DISPLAY" ]] && (( $+commands[xclip] )); then
    xclip -selection clipboard
  else
    printf '\033]52;c;%s\a' "$(base64 | tr -d '\n')"
  fi
}

eval "$(mise activate zsh)"

path=(${(M)path:#${XDG_DATA_HOME}/mise/installs/*} ${path:#${XDG_DATA_HOME}/mise/installs/*})
export __MISE_ZSH_ACTIVATE_PATH="$PATH"

eval "$(sheldon source)"

function _init_ssh_agent() {
  local key="$HOME/.ssh/id_ed25519"
  [[ -r $key ]] || return 0
  ssh-add -l &>/dev/null
  case $? in
    0) ;;
    1) ssh-add -q "$key" </dev/null &>/dev/null || true ;;
    *) (( $+commands[keychain] )) &&
      eval "$(keychain --eval --nogui --quiet --agents ssh "$key")" ;;
  esac
  unset -f _init_ssh_agent
}
zsh-defer _init_ssh_agent

setopt auto_cd
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt extended_history
setopt inc_append_history
setopt nonomatch

zsh-defer -c "bindkey '^ ' autosuggest-accept"
zsh-defer -c "bindkey ' ' zeno-auto-snippet; bindkey '^]' zeno-ghq-cd; bindkey '^r' zeno-history-selection; bindkey '^x' zeno-insert-snippet"
