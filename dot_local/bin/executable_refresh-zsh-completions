#!/usr/bin/env bash
set -eu

COMP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions"
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/completions.stamp"
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"

export MISE_NO_HOOKS=1

FORCE=0
case "${1:-}" in
  -f | --force) FORCE=1 ;;
  "") ;;
  *)
    printf 'usage: %s [-f|--force]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

NAMES=(chezmoi gh deno jj zellij bw bat typst mise)

emit() {
  local name="$1" version="$2" tool
  tool="$(mise_tool "$name")"
  if [ -z "$tool" ]; then
    "$MISE" completion zsh
    return
  fi
  local -a run=("$MISE" exec "$tool@$version" --)
  case "$name" in
    chezmoi) "${run[@]}" chezmoi completion zsh ;;
    gh) "${run[@]}" gh completion -s zsh ;;
    deno) "${run[@]}" deno completions zsh ;;
    jj) "${run[@]}" jj util completion zsh ;;
    zellij) "${run[@]}" zellij setup --generate-completion zsh ;;
    bw) BITWARDENCLI_APPDATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Bitwarden CLI" "${run[@]}" bw completion --shell zsh ;;
    bat) "${run[@]}" bat --completion zsh ;;
    typst) "${run[@]}" typst completions zsh ;;
    *) return 1 ;;
  esac
}

mise_tool() {
  case "$1" in
    jj) printf 'jujutsu\n' ;;
    bw) printf 'bitwarden\n' ;;
    mise) printf '\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

comp_files() {
  find "$COMP_DIR" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | LC_ALL=C sort || true
}

mkdir -p "$COMP_DIR" "$(dirname "$STAMP")"

if ! MISE_LS="$("$MISE" ls --installed --no-header 2>/dev/null)"; then
  printf 'mise is not usable; leaving existing completions untouched.\n' >&2
  exit 0
fi
MISE_OWN="$("$MISE" --version 2>/dev/null | awk '{ print $1 }' || true)"

version_of() {
  local tool
  tool="$(mise_tool "$1")"
  if [ -z "$tool" ]; then
    printf '%s\n' "${MISE_OWN:-unknown}"
    return
  fi
  printf '%s\n' "$MISE_LS" |
    awk -v t="$tool" '$1 == t { v = $2 } END { if (v != "") print v }'
}

stamp_field() {
  [ -r "$STAMP" ] || return 0
  awk -F'\t' -v n="$1" -v f="$2" '$1 == n { print $f; exit }' "$STAMP"
}

BEFORE="$(comp_files)"
NEW_STAMP="$(mktemp)"
# shellcheck disable=SC2064  # 展開は trap 設定時に済ませたい
trap "rm -f '$NEW_STAMP'" EXIT

announced=0
announce() {
  [ "$announced" -eq 0 ] || return 0
  printf "\e[1;36mGenerate zsh completions\e[m\n"
  announced=1
}

for name in "${NAMES[@]}"; do
  version="$(version_of "$name")"

  if [ -z "$version" ]; then
    if [ -e "$COMP_DIR/_$name" ]; then
      announce
      rm -f "$COMP_DIR/_$name"
      printf "  removed _%s (not installed)\n" "$name"
    fi
    continue
  fi

  prev_version="$(stamp_field "$name" 2)"
  prev_state="$(stamp_field "$name" 3)"

  need=0
  if [ "$FORCE" -eq 1 ]; then
    need=1
  elif [ -z "$prev_version" ] || [ "$prev_version" != "$version" ]; then
    need=1
  elif [ "$prev_state" = "ok" ] && [ ! -s "$COMP_DIR/_$name" ]; then
    need=1
  fi

  if [ "$need" -eq 0 ]; then
    printf '%s\t%s\t%s\n' "$name" "$version" "$prev_state" >>"$NEW_STAMP"
    continue
  fi

  announce
  if out="$(emit "$name" "$version" 2>/dev/null)" && [ -n "$out" ]; then
    printf '%s' "$out" >"$COMP_DIR/_$name"
    printf "  generated _%s (%s)\n" "$name" "$version"
    printf '%s\t%s\tok\n' "$name" "$version" >>"$NEW_STAMP"
  else
    printf "  skip _%s (generation failed)\n" "$name"
    printf '%s\t%s\tskip\n' "$name" "$version" >>"$NEW_STAMP"
  fi
done

mv "$NEW_STAMP" "$STAMP"
trap - EXIT

if [ "$BEFORE" != "$(comp_files)" ]; then
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-"*
  printf "  completion files changed; dropped stale zcompdump\n"
fi
