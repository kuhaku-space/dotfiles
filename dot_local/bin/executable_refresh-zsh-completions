#!/usr/bin/env bash
set -eu

COMP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
CARAPACE_INIT="$CACHE_DIR/carapace-init.zsh"
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/completions.stamp"
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"

export MISE_NO_HOOKS=1
unset CARAPACE_EXCLUDES

FORCE=0
case "${1:-}" in
  -f | --force) FORCE=1 ;;
  "") ;;
  *)
    printf 'usage: %s [-f|--force]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

NAMES=(bw mise)

emit() {
  local name="$1" version="$2" tool
  tool="$(mise_tool "$name")"
  if [ -z "$tool" ]; then
    "$MISE" completion zsh
    return
  fi
  local -a run=("$MISE" exec "$tool@$version" --)
  case "$name" in
    bw) BITWARDENCLI_APPDATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Bitwarden CLI" "${run[@]}" bw completion --shell zsh ;;
    *) return 1 ;;
  esac
}

mise_tool() {
  case "$1" in
    bw) printf 'bitwarden\n' ;;
    mise) printf '\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

comp_files() {
  find "$COMP_DIR" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | LC_ALL=C sort || true
}

mkdir -p "$COMP_DIR" "$CACHE_DIR" "$(dirname "$STAMP")"

if ! MISE_LS="$("$MISE" ls --installed --no-header 2>/dev/null)"; then
  printf 'mise is not usable; leaving existing completions untouched.\n' >&2
  exit 0
fi
MISE_OWN="$("$MISE" --version 2>/dev/null | awk '{ print $1 }' || true)"

version_of() {
  local tool
  tool="$(mise_tool "$1")"
  if [ -z "$tool" ]; then
    printf '%s\n' "${MISE_OWN:-unknown}"
    return
  fi
  printf '%s\n' "$MISE_LS" |
    awk -v t="$tool" '$1 == t { v = $2 } END { if (v != "") print v }'
}

stamp_field() {
  [ -r "$STAMP" ] || return 0
  awk -F'\t' -v n="$1" -v f="$2" '$1 == n { print $f; exit }' "$STAMP"
}

BEFORE="$(comp_files)"
NEW_STAMP="$(mktemp)"
# shellcheck disable=SC2064  # 展開は trap 設定時に済ませたい
trap "rm -f '$NEW_STAMP'" EXIT

announced=0
announce() {
  [ "$announced" -eq 0 ] || return 0
  printf "\e[1;36mGenerate zsh completions\e[m\n"
  announced=1
}

is_static_name() {
  local candidate="$1" name
  for name in "${NAMES[@]}"; do
    [ "$candidate" = "$name" ] && return 0
  done
  return 1
}

if [ -r "$STAMP" ]; then
  while IFS=$'\t' read -r old_name _; do
    [ "$old_name" = "carapace-init" ] && continue
    if ! is_static_name "$old_name" && [ -e "$COMP_DIR/_$old_name" ]; then
      announce
      rm -f "$COMP_DIR/_$old_name"
      printf "  removed _%s (managed by carapace)\n" "$old_name"
    fi
  done <"$STAMP"
fi

for name in "${NAMES[@]}"; do
  version="$(version_of "$name")"

  if [ -z "$version" ]; then
    if [ -e "$COMP_DIR/_$name" ]; then
      announce
      rm -f "$COMP_DIR/_$name"
      printf "  removed _%s (not installed)\n" "$name"
    fi
    continue
  fi

  prev_version="$(stamp_field "$name" 2)"
  prev_state="$(stamp_field "$name" 3)"

  need=0
  if [ "$FORCE" -eq 1 ]; then
    need=1
  elif [ -z "$prev_version" ] || [ "$prev_version" != "$version" ]; then
    need=1
  elif [ "$prev_state" = "ok" ] && [ ! -s "$COMP_DIR/_$name" ]; then
    need=1
  fi

  if [ "$need" -eq 0 ]; then
    printf '%s\t%s\t%s\n' "$name" "$version" "$prev_state" >>"$NEW_STAMP"
    continue
  fi

  announce
  if out="$(emit "$name" "$version" 2>/dev/null)" && [ -n "$out" ]; then
    printf '%s' "$out" >"$COMP_DIR/_$name"
    printf "  generated _%s (%s)\n" "$name" "$version"
    printf '%s\t%s\tok\n' "$name" "$version" >>"$NEW_STAMP"
  else
    printf "  skip _%s (generation failed)\n" "$name"
    printf '%s\t%s\tskip\n' "$name" "$version" >>"$NEW_STAMP"
  fi
done

carapace_version="$(version_of carapace)"
if [ -z "$carapace_version" ]; then
  if [ -e "$CARAPACE_INIT" ]; then
    announce
    rm -f "$CARAPACE_INIT"
    printf "  removed carapace init (not installed)\n"
  fi
else
  prev_version="$(stamp_field carapace-init 2)"
  prev_state="$(stamp_field carapace-init 3)"
  need=0
  if [ "$FORCE" -eq 1 ]; then
    need=1
  elif [ -z "$prev_version" ] || [ "$prev_version" != "$carapace_version" ]; then
    need=1
  elif [ "$prev_state" = "ok" ] && [ ! -s "$CARAPACE_INIT" ]; then
    need=1
  fi

  if [ "$need" -eq 1 ]; then
    announce
    carapace_tmp="$(mktemp "$CACHE_DIR/carapace-init.XXXXXX")"
    if "$MISE" exec "carapace@$carapace_version" -- carapace _carapace zsh >"$carapace_tmp" 2>/dev/null &&
      [ -s "$carapace_tmp" ]; then
      mv "$carapace_tmp" "$CARAPACE_INIT"
      printf "  generated carapace init (%s)\n" "$carapace_version"
      printf 'carapace-init\t%s\tok\n' "$carapace_version" >>"$NEW_STAMP"
    else
      rm -f "$carapace_tmp"
      printf "  skip carapace init (generation failed)\n"
      printf 'carapace-init\t%s\tskip\n' "$carapace_version" >>"$NEW_STAMP"
    fi
  else
    printf 'carapace-init\t%s\t%s\n' "$carapace_version" "$prev_state" >>"$NEW_STAMP"
  fi
fi

mv "$NEW_STAMP" "$STAMP"
trap - EXIT

if [ "$BEFORE" != "$(comp_files)" ]; then
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-"*
  printf "  completion files changed; dropped stale zcompdump\n"
fi
